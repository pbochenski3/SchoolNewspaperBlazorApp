@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService
@inject IFileService fileService

<div class="add-article-form">

    <h1>Dodaj artykul</h1>
    @if (previewImage != null)
    {
        <div class="image-preview">
            <img src="@previewImage" alt="zdjecie" />
        </div>
    }
    <InputFile OnChange="ChoosePhoto" accept="image/*" />
    <form @onsubmit="AddArticle" @onsubmit:preventDefault>
        <input @bind="title" class="form-control" />
        <textarea @bind="text" class="form-control" />
        <input @bind="author" class="form-control" />
        <button type="submit" class="btn btn-primary">Dodaj</button>
    </form>
</div>

@code {
    private string title = "";
    private string text = "";
    private string author = "";
    private string? previewImage;
    IBrowserFile? file;
    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        file = e.File;
        previewImage = await fileService.GetPreviewAsync(file);
    }

    private async Task AddArticle()
    {
        int id = 0;
        if(file != null)
        {
        id = await fileService.UploadImage(file);
        }
        await articleService.AddArticleAsync(title, text, author,id);
    }
}

