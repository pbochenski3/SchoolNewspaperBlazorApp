@using Microsoft.AspNetCore.Components.Authorization
@using SchoolNewspaperBlazorApp.Service
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inherits LayoutComponentBase
@inject AuthenticationStateProvider asp;
@inject IPermissionService permissionService

<div class="site-shell">
    <header class="site-header">
        <div class="site-header__inner">

            <a class="brand" href="/" aria-label="Gazetka szkolna ETI">
                <span class="brand__logo-wrap">
                    <img src="/logo.png"
                         class="brand__logo"
                         alt="Logo ETI" />
                </span>

                <span class="brand__text">
                    <span class="brand__name">GAZETKA SZKOLNA</span>
                    <span class="brand__subtitle">
                        Elitarne Technikum Informatyczne
                    </span>
                </span>
            </a>

            <nav class="main-nav" aria-label="Menu główne">
                <NavLink class="main-nav__link"
                         href="/"
                         Match="NavLinkMatch.All">
                    <span class="nav-icon">⌂</span>
                    Strona główna
                </NavLink>

                <NavLink class="main-nav__link" href="/aktualnosci">
                    <span class="nav-icon">▤</span>
                    Aktualności
                </NavLink>

                <NavLink class="main-nav__link" href="/aktualnosci?typ=Events">
                    <span class="nav-icon">▦</span>
                    Wydarzenia
                </NavLink>

                <NavLink class="main-nav__link" href="/zastepstwa">
                    <span class="nav-icon">⇄</span>
                    Zastępstwa
                </NavLink>
            </nav>
            @if (!IsLoggedIn)
            {
                <div class="site-header__actions">
                    <NavLink class="header-login" href="/login">
                        <span>♙</span>
                        Zaloguj się
                    </NavLink>
                </div>
            }
            else
            {
                <div class="site-header__actions"
                     style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px;">
                    <span class="header-user"
                          title="@displayName"
                          style="min-width: 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #183a68; font-size: 13px; font-weight: 750;">
                        Witaj ponownie @displayName!
                    </span>

                    <form method="post" action="/auth/logout" style="flex: 0 0 auto; margin: 0;">
                        <button type="submit" class="header-login" style="cursor: pointer;">
                            <span>♙</span>
                            Wyloguj się
                        </button>
                    </form>
                </div>
            }

        </div>

        <div class="site-header__bottom">
            <div class="site-header__bottom-inner">
                <div class="site-status">
                    <span class="site-status__dot"></span>
                    <span>Twoje szkolne centrum informacji</span>
                </div>
                @if (CanOpenAdminPanel)
                {
                    <NavLink class="admin-link" href="/adminPanel">
                        <span class="admin-link__icon">⚙</span>
                        Panel administratora
                        <span>↗</span>
                    </NavLink>
                }
            </div>
        </div>
    </header>

    <main class="site-main">
        @Body
    </main>

    ```razor
    <footer class="site-footer">
        <div class="site-footer__inner">

            <div class="site-footer__brand">
                <img src="/logo.png"
                     class="site-footer__logo"
                     alt="Logo ETI" />

                <div>
                    <strong>Gazetka szkolna ETI</strong>
                    <p>Szkolne wiadomości. Nasze historie.</p>
                </div>
            </div>

            <nav class="site-footer__links" aria-label="Linki w stopce">
                <NavLink href="/" Match="NavLinkMatch.All">
                    Strona główna
                </NavLink>
                <NavLink href="/aktualnosci">Aktualności</NavLink>
                <NavLink href="/aktualnosci?typ=Events">Wydarzenia</NavLink>
                <NavLink href="/zastepstwa">Zastępstwa</NavLink>
                <a href="https://technikuminformatyczne.edu.pl/"
                   target="_blank"
                   rel="noopener noreferrer">
                    Strona szkoły ↗
                </a>
            </nav>

            <div class="site-footer__bottom">
                <span class="site-footer__copyright">
                    © @DateTime.Now.Year ETI
                </span>
                <span class="site-footer__credits">
                    Stworzone podczas praktyk przez klasę 3TA
                </span>
            </div>

        </div>
    </footer>
    ```
</div>
@code{
    private bool IsLoggedIn;
    private bool CanOpenAdminPanel;
    private string displayName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await asp.GetAuthenticationStateAsync();
        var user = authState.User;
        IsLoggedIn = user.Identity?.IsAuthenticated ?? false;

        if (IsLoggedIn)
        {
            var fullName = user.FindFirst("FullName")?.Value;
            displayName = fullName ?? user.Identity?.Name ?? string.Empty;

            // link do panelu tylko dla kont, które mają jakiekolwiek uprawnienie
            CanOpenAdminPanel = await permissionService.HasAnyPermissionAsync();
        }
    }

}
